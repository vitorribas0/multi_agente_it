IARA_CLIENT_ID=your_client_id
IARA_CLIENT_SECRET=your_client_secret
IARA_ENVIRONMENT=homol
IARA_PROVIDER=azure_openai
IARA_MODEL=gpt-4o
IARA_ACCESS_TOKEN=your_access_token

# Chave usada pelo runtime Codex portátil da Atena
OPENAI_API_KEY=sk-...
ATENA_CODEX_MODEL=gpt-5.6-terra
ATENA_CODEX_REASONING_EFFORT=medium

# Opcional: diretório persistente do runtime. O padrão já é runtime/codex_home.
# Em ECS, aponte para um volume persistente, por exemplo /data/atena/codex_home.
# ATENA_CODEX_HOME=runtime/codex_home

[759242759842_CONSUMER]
aws_access_key_id=YOUR_AWS_ACCESS_KEY_ID
aws_secret_access_key=YOUR_AWS_SECRET_ACCESS_KEY
aws_session_token=YOUR_AWS_SESSION_TOKEN

AWS_DEFAULT_REGION=sa-east-1
AWS_CA_BUNDLE=arquivos_suporte/cacert.pem
REQUESTS_CA_BUNDLE=arquivos_suporte/cacert.pem
CURL_CA_BUNDLE=arquivos_suporte/cacert.pem

# Django
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True

# Se sua rede exigir proxy, exporte `HTTP_PROXY`/`HTTPS_PROXY` externamente.
