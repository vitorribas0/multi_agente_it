# ── Credenciais IARA GenAI (SDK iaragenai) ─────────────────────────────
# Preencha LOCALMENTE. Nunca versione este arquivo já preenchido.
IARA_CLIENT_ID=your_client_id
IARA_CLIENT_SECRET=your_client_secret
IARA_ENVIRONMENT=homol            # dev | homol | prod
IARA_PROVIDER=azure_openai        # azure_openai (GPT) | bedrock (Claude) | vertex (Gemini)
IARA_MODEL=gpt-5.6-terra          # id exato do catálogo IARA (ex.: gpt-5.6-terra, gpt-5.5)
IARA_ACCESS_TOKEN=your_access_token   # x-genai-access-token do portal (opcional p/ o SDK)

# ── Provedor IARA para o Codex (via adaptador Responses local) ─────────
# Liga/desliga o uso do IARA como provedor do Codex. Com false, o Atena
# usa o caminho OpenAI padrão (rollback imediato — ver readm_implementar_iara.md §14).
#
# O adaptador faz PASSTHROUGH da Responses API do Codex para client.responses
# do SDK iaragenai (o Codex 0.147 usa ferramentas grammar nativas da Responses
# API, impossíveis de traduzir p/ chat.completions). Requisito de rede: o host
# do gateway SSE do IARA (base_url_sse = agent-gateway.{env}.aws.cloud.ihf)
# precisa ser ALCANÇÁVEL de onde o app roda. Verifique com:
#     python -m testes.iara.check_iara_responses_reachable
ATENA_IARA_ENABLED=false
# Host/porta em que o adaptador Responses-compatível escuta (somente localhost).
ATENA_IARA_ADAPTER_HOST=127.0.0.1
ATENA_IARA_ADAPTER_PORT=8799
# Token interno compartilhado entre Codex e adaptador (autenticação local, §9).
# Gere um valor aleatório; o adaptador recusa requisições sem ele quando setado.
ATENA_IARA_ADAPTER_TOKEN=troque_por_um_token_aleatorio_local

# Chave usada pelo runtime Codex portátil da Atena (caminho OpenAI padrão)
OPENAI_API_KEY=sk-...
ATENA_CODEX_MODEL=gpt-5.6-terra
ATENA_CODEX_REASONING_EFFORT=medium

# Opcional: diretório persistente do runtime. O padrão já é runtime/codex_home.
# Em ECS, aponte para um volume persistente, por exemplo /data/atena/codex_home.
# ATENA_CODEX_HOME=runtime/codex_home

[759242759842_CONSUMER]
aws_access_key_id=YOUR_AWS_ACCESS_KEY_ID
aws_secret_access_key=YOUR_AWS_SECRET_ACCESS_KEY
aws_session_token=YOUR_AWS_SESSION_TOKEN

AWS_DEFAULT_REGION=sa-east-1
AWS_CA_BUNDLE=arquivos_suporte/cacert.pem
REQUESTS_CA_BUNDLE=arquivos_suporte/cacert.pem
CURL_CA_BUNDLE=arquivos_suporte/cacert.pem

# Django
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True

# Se sua rede exigir proxy, exporte `HTTP_PROXY`/`HTTPS_PROXY` externamente.
